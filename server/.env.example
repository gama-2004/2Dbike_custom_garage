# このファイルを .env という名前でコピーして、自分の環境に合わせて書き換える
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=(MySQL をインストールしたときに決めた root のパスワード)
DB_NAME=custom_garage
# セッションの暗号化に使う。長いランダムな文字列にする
SESSION_SECRET=change-this-to-a-long-random-string
# https で公開するときは true にする
COOKIE_SECURE=false
# npm run db:init で作る最初の管理者。パスワードを空にすると、ランダムなパスワードを作って表示する
ADMIN_LOGIN_ID=admin
ADMIN_NAME=管理者
ADMIN_PASSWORD=
