{
  "name": "2dbike-custom-garage-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "db:init": "tsx --env-file-if-exists=.env src/scripts/init-db.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/scripts/init-db.ts --reset",
    "admin:add": "tsx --env-file-if-exists=.env src/scripts/add-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "mysql2": "3.24.6",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.19.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
