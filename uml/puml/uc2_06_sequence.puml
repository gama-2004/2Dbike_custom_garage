@startuml
skinparam defaultFontName "Noto Sans CJK JP"
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #3b4250
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
autonumber
hide footbox
title 2-06 取り消し シーケンス図
actor "利用者" as U
boundary "カスタム画面\nCustomizeScreen" as CS
boundary "車両ビュー\nBikeView" as BV
control "履歴管理\nHistoryManager" as HM
control "描画制御\nRenderer" as RD
entity "変更履歴\nEditCommand" as EC
entity "作業状態\nWorkspace" as WS
U -> CS : 元に戻す
activate CS
CS -> HM : undo()
activate HM
HM -> HM : cmd = undoStack.pop()
HM -> EC : getBefore()
EC --> HM : before
HM -> WS : setCurrent(before)
HM -> HM : redoStack.push(cmd)
HM -> RD : render()
activate RD
RD -> BV : display(svg)
deactivate RD
HM --> CS : canUndo(), canRedo()
deactivate HM
CS -> CS : updateButtons(canUndo, canRedo)
deactivate CS
note over CS, HM : やり直す(redo)は、redoStackから取り出して\ngetAfter()を適用し、undoStackへ戻す
@enduml
